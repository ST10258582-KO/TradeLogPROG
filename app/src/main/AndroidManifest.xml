<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet and connectivity — REST API + Firebase (NFR-04) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Biometric authentication — fingerprint or face unlock (POE Feature: Biometric Auth) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Push notifications — Firebase Cloud Messaging (POE Feature: Real-time Notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera and storage — trade chart screenshot upload (POE Feature: Blob Storage) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradeLog"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".TradeLogApplication"
        tools:targetApi="31">

        <!-- Main entry point — single-activity Compose app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TradeLog"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging service — receives push notifications (POE Feature: Real-time Notifications)
             Reference: Firebase, "Firebase Cloud Messaging" (Google LLC, 2024) -->
        <service
            android:name=".services.TradeLogMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM default notification channel for Android 8.0+ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tradelog_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

    </application>

</manifest>
